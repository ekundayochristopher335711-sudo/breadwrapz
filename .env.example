# Rename this file to .env and fill in your keys

# From Paystack dashboard → Settings → API Keys
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxx

# Where Paystack sends the customer after payment
PAYSTACK_CALLBACK_URL=https://breadwrapz.netlify.app/

# From Paystack dashboard → Settings → Webhooks (after adding your webhook URL)
PAYSTACK_WEBHOOK_SECRET=your_webhook_secret_here

PORT=4000
